# Example environment variables for local development
# Replace with your real credentials in a local `.env` file (do NOT commit secrets)

DATABASE_URL="postgresql://usuario:senha@localhost:5432/banco?schema=public"
PORT=3000
CORS_ORIGINS="http://localhost:5173"

# Use pelo menos 32 caracteres aleatórios e um valor diferente em cada ambiente.
CSRF_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"

# Obrigatória apenas para `npm run prisma:seed`; nunca versione uma senha real.
SEED_DEFAULT_PASSWORD="uma-senha-inicial-com-15-caracteres"
