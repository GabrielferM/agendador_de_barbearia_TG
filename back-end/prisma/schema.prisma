generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoPerfil {
  CLIENTE
  BARBEIRO
}

enum StatusBarbeiro {
  ATIVO
  INATIVO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

model Usuario {
  id           Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  senha        String
  dataCadastro DateTime    @default(now())
  tipoPerfil   TipoPerfil
  cliente      Cliente?    @relation("UsuarioCliente")
  barbeiro     Barbeiro?   @relation("UsuarioBarbeiro")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@map("usuario")
}

model Cliente {
  id             Int           @id
  cpf            String        @unique
  dataNascimento DateTime?
  usuario        Usuario       @relation("UsuarioCliente", fields: [id], references: [id], onDelete: Cascade)
  agendamentos   Agendamento[] @relation("ClienteAgendamentos")
  @@map("cliente")
}

model Barbeiro {
  id            Int              @id
  descricao     String?
  dataAdmissao  DateTime?
  status        StatusBarbeiro   @default(ATIVO)
  idFilial      Int
  filial        Filial           @relation("FilialBarbeiros", fields: [idFilial], references: [id], onDelete: Restrict)
  usuario       Usuario          @relation("UsuarioBarbeiro", fields: [id], references: [id], onDelete: Cascade)
  agendamentos  Agendamento[]    @relation("BarbeiroAgendamentos")
  @@index([idFilial])
  @@map("barbeiro")
}

model Filial {
  id                 Int           @id @default(autoincrement())
  nome               String
  cnpj               String        @unique
  telefone           String?
  email              String?
  horarioAbertura    String?
  horarioFechamento  String?
  idEndereco         Int           @unique
  endereco           Endereco      @relation("FilialEndereco", fields: [idEndereco], references: [id], onDelete: Restrict)
  barbeiros          Barbeiro[]    @relation("FilialBarbeiros")
  agendamentos       Agendamento[] @relation("FilialAgendamentos")
  @@map("filial")
}
model Endereco {
  id         Int       @id @default(autoincrement())
  cep        String
  logradouro String
  numero     String
  bairro     String
  cidade     String
  estado     String
  filial     Filial?   @relation("FilialEndereco")
  @@map("endereco")
}

model Servico {
  id              Int                  @id @default(autoincrement())
  nome            String
  descricao       String?
  preco           Decimal              @db.Decimal(10, 2)
  duracaoMinutos  Int
  agendamentos    AgendamentoServico[] @relation("ServicoAgendamentos")
  @@map("servico")
}

model Agendamento {
  id              Int                 @id @default(autoincrement())
  idCliente       Int
  idBarbeiro      Int
  idFilial        Int
  inicio          DateTime
  fim             DateTime
  status          StatusAgendamento   @default(AGENDADO)
  observacao      String?
  valorTotal      Decimal             @db.Decimal(10, 2)
  dataCriacao     DateTime            @default(now())
  cliente         Cliente             @relation("ClienteAgendamentos", fields: [idCliente], references: [id], onDelete: Restrict)
  barbeiro        Barbeiro            @relation("BarbeiroAgendamentos", fields: [idBarbeiro], references: [id], onDelete: Restrict)
  filial          Filial              @relation("FilialAgendamentos", fields: [idFilial], references: [id], onDelete: Restrict)
  servicos        AgendamentoServico[] @relation("AgendamentoServicos")
  @@index([idCliente])
  @@index([idBarbeiro])
  @@index([idFilial])
  @@index([inicio])
  @@index([idBarbeiro, inicio])
  @@index([status])
  @@map("agendamento")
}

model AgendamentoServico {
  id              Int          @id @default(autoincrement())
  idAgendamento   Int
  idServico       Int
  preco           Decimal      @db.Decimal(10, 2)
  duracaoMinutos  Int
  agendamento     Agendamento  @relation("AgendamentoServicos", fields: [idAgendamento], references: [id], onDelete: Cascade)
  servico         Servico      @relation("ServicoAgendamentos", fields: [idServico], references: [id], onDelete: Restrict)
  @@unique([idAgendamento, idServico])
  @@index([idServico])
  @@map("agendamento_servico")
}
